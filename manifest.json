{
  "manifest_version": 3,
  "name": "Pointee",
  "version": "2.0.0",
  "description": "Point at any element, copy a source pointer for your coding agent, edit it live — styles, text, design tokens, even WebGL shaders.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/light-16.png",
      "32": "icons/light-32.png",
      "48": "icons/light-48.png",
      "128": "icons/light-128.png"
    },
    "default_title": "Toggle Point Mode"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/html2canvas-pro.min.js",
        "content.js"
      ],
      "css": [
        "tokens.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/light-16.png",
    "48": "icons/light-48.png",
    "128": "icons/light-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
